{
  "name": "iaisw-daily",
  "version": "1.0.0",
  "private": true,
  "description": "工业智能与工业软件信息搜索智能体（React + Node.js + DeepSeek + PostgreSQL）",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server run start",
    "migrate": "npm --prefix server run migrate",
    "run:once": "npm --prefix server run collect",
    "install:all": "npm --prefix server install && npm --prefix web install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
